rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️⚠️ 공유 파일 — 반드시 읽을 것 ⚠️⚠️
    //
    // 이 규칙은 Firebase 프로젝트(gen-lang-client-0283055211) 전체에 적용된다.
    // 이 프로젝트는 서로 다른 두 앱이 공유한다:
    //   - meet4u    (~/meet4u)                  → users, meetings, projects, chats, ...
    //   - call_map  (~/call_map/global-meet)    → callMap* 네임스페이스
    //
    // Firestore 보안 규칙은 프로젝트당 하나뿐이고, 배포하면 전체가 통째로
    // 덮어써진다. 따라서 두 저장소의 firestore.rules 는 항상 똑같아야 한다.
    //
    //   diff ~/meet4u/firestore.rules ~/call_map/global-meet/firestore.rules
    //
    // 위 명령 결과가 비어 있어야 정상이다. 한쪽에서만 고치고 배포하면
    // 다른 앱이 default deny 에 걸려 즉시 죽는다. 규칙을 바꿀 때는
    // 양쪽 파일을 함께 고치고 한 번만 배포할 것.

    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function myUid() {
      return request.auth.uid;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(myUid()))
        && get(/databases/$(database)/documents/users/$(myUid())).data.role == 'admin';
    }

    function onlyAffects(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function roomDoc(roomId) {
      return get(/databases/$(database)/documents/globalChatRooms/$(roomId));
    }

    function isRoomMember(roomId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/globalChatRooms/$(roomId))
        && myEmail() in roomDoc(roomId).data.members;
    }

    function isRoomOwner(roomId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/globalChatRooms/$(roomId))
        && roomDoc(roomId).data.createdBy == myEmail();
    }

    // ---------- Helpers: call_map 전용 ----------
    // 위 roomDoc/isRoomMember/isRoomOwner 는 globalChatRooms 를 보므로
    // callMapChatRooms 에는 재사용할 수 없다. 같은 로직의 별도 헬퍼가 필요하다.
    function callMapRoomDoc(roomId) {
      return get(/databases/$(database)/documents/callMapChatRooms/$(roomId));
    }

    function isCallMapRoomMember(roomId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/callMapChatRooms/$(roomId))
        && myEmail() in callMapRoomDoc(roomId).data.members;
    }

    function isCallMapRoomOwner(roomId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/callMapChatRooms/$(roomId))
        && callMapRoomDoc(roomId).data.createdBy == myEmail();
    }

    // ---------- Users ----------
    // Any signed-in user can read (needed for member search / attendee lookups).
    // Owner creates/updates own profile. Admin can update anyone (role changes).
    match /users/{userId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && myUid() == userId;
      allow update: if isSignedIn() && (myUid() == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // ---------- Meetings ----------
    // Signed-in users can read and create.
    // Updates allowed (RSVP, comments-count, etc.) while signed in.
    // Delete limited to creator or admin.
    match /meetings/{meetingId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn()
        && (resource.data.createdBy == myUid() || isAdmin());
    }

    // ---------- Projects ----------
    // 모든 인증 사용자가 읽기/생성 가능. 갱신은 멤버 본인 또는 관리자.
    // 삭제는 생성자 또는 관리자만(soft-delete 권장: deleted=true).
    match /projects/{projectId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn()
        && (resource.data.createdBy == request.auth.token.email.lower() || isAdmin());
    }

    // ---------- Meta / migration flags ----------
    match /meta/{docId} {
      allow read:  if isSignedIn();
      allow write: if isSignedIn() && isAdmin();
    }

    // ---------- Per-meeting comments ----------
    // Read/create by signed-in user. Update for readBy arrayUnion + translations cache.
    // Delete by the original sender only.
    match /comments/{commentId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.senderEmail == request.auth.token.email;
      allow update: if isSignedIn();
      allow delete: if isSignedIn()
        && resource.data.senderEmail == request.auth.token.email;
    }

    // ---------- 1:1 chats ----------
    // Only participants (raw email stored in chats.participants) can read/write.
    match /chats/{chatId} {
      allow read: if isSignedIn()
        && request.auth.token.email in resource.data.participants;
      allow create: if isSignedIn()
        && request.auth.token.email in request.resource.data.participants;
      allow update: if isSignedIn()
        && request.auth.token.email in resource.data.participants;
      allow delete: if isSignedIn()
        && request.auth.token.email in resource.data.participants;

      match /messages/{messageId} {
        allow read, create: if isSignedIn()
          && request.auth.token.email in
             get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update: if isSignedIn()
          && request.auth.token.email in
             get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow delete: if isSignedIn()
          && resource.data.senderEmail == request.auth.token.email;
      }
    }

    // ---------- Global pins (map) ----------
    // meet4u 전용. call_map 은 더 이상 이 컬렉션을 쓰지 않는다(callMapPins 참고).
    // Anyone signed-in can read and add pins.
    // Only the creator (or admin) can delete. No updates.
    match /globalPins/{pinId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.token.email;
      allow update: if false;
      allow delete: if isSignedIn()
        && (resource.data.createdBy == request.auth.token.email || isAdmin());
    }

    // ---------- Global chat rooms (invite-based) ----------
    // Only members can read. Members are stored as lowercase emails.
    match /globalChatRooms/{roomId} {
      allow read: if isSignedIn() && myEmail() in resource.data.members;

      allow create: if isSignedIn()
        && request.resource.data.createdBy == myEmail()
        && (myEmail() in request.resource.data.members);

      // Owner can update anything.
      // Non-owner member may only leave (remove own email from `members`
      // with no other fields changing).
      allow update: if isSignedIn() && (
        resource.data.createdBy == myEmail()
        ||
        (
          myEmail() in resource.data.members
          && onlyAffects(['members'])
          && !(myEmail() in request.resource.data.members)
        )
      );

      allow delete: if isSignedIn() && resource.data.createdBy == myEmail();

      match /messages/{messageId} {
        allow read: if isRoomMember(roomId);

        allow create: if isRoomMember(roomId)
          && request.resource.data.senderEmail == request.auth.token.email;

        // Update allowed for readBy arrayUnion + translations cache.
        allow update: if isRoomMember(roomId);

        allow delete: if isSignedIn()
          && (resource.data.senderEmail == request.auth.token.email
              || isRoomOwner(roomId)
              || isAdmin());
      }
    }

    // ---------- Live location sharing ----------
    // liveLocations/{userId} — only the owner writes their own doc.
    // All signed-in users may read so they can see others on the map.
    match /liveLocations/{userId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && myUid() == userId;
      allow update: if isSignedIn() && myUid() == userId;
      allow delete: if isSignedIn() && myUid() == userId;
    }

    // ---------- Legacy: shops collection (no longer used by the UI) ----------
    // Read by signed-in user; writes limited to admin for cleanup only.
    match /shops/{shopId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------- Guest meetups (테니스 게스트 모집) ----------
    // 새 도메인 컬렉션. 기존 meetings 는 그대로 두고 별개 컬렉션에서 관리.
    //  - read: 로그인 사용자
    //  - create: 로그인 사용자, createdBy == auth.uid 강제
    //  - update: 호스트(createdBy) 또는 참가/취소/대기/입금 등 부분 갱신
    //    (roster/wait/closed/updatedAt 만 바뀌는 요청은 참가자·게스트도 허용)
    //  - delete: 호스트만
    match /guestMeetups/{id} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.createdBy == myUid();

      // update 허용 조건:
      //   1) 호스트(createdBy) 는 무제한 수정
      //   2) 관리자는 무제한 수정 (장소 rename 일괄 처리 등)
      //   3) 그 외 로그인 사용자는 roster/wait/closed/updatedAt 필드만
      //      바꾸는 요청(참가/취소/대기/승격/입금 케이스) 에 한해 허용
      allow update: if isSignedIn() && (
        resource.data.createdBy == myUid()
        || isAdmin()
        ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['roster', 'wait', 'closed', 'updatedAt'])
      );

      allow delete: if isSignedIn()
        && (resource.data.createdBy == myUid() || isAdmin());
    }

    // ---------- App config (menu permissions, etc.) ----------
    // Any signed-in user can read (sidebar subscribes for menu visibility).
    // Only admins can change.
    match /config/{configId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ============================================================
    // call_map 전용 영역 (~/call_map/global-meet)
    //
    // meet4u 와 데이터가 섞이지 않도록 분리한 네임스페이스다.
    // 컬렉션 이름은 call_map 의 src/lib/collections.js 안 COL 값과
    // 반드시 일치해야 한다. meet4u 는 이 컬렉션들을 쓰지 않지만,
    // 이 블록을 지우고 배포하면 call_map 사이트가 즉시 죽는다.
    //
    // 참고: 아래 규칙은 일부러 isAdmin() 을 쓰지 않는다. isAdmin() 은
    // meet4u 의 users 컬렉션을 보는데, call_map 사용자는 callMapUsers 에
    // 있어서 절대 admin 으로 판정되지 않기 때문이다.
    // ============================================================

    match /callMapUsers/{userId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && myUid() == userId;
      allow update: if isSignedIn() && myUid() == userId;
      allow delete: if false;
    }

    // globalPins 와 달리 update 를 허용한다.
    // call_map 에는 핀 제목/추가정보를 인라인 편집하는 기능이 있다.
    match /callMapPins/{pinId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.token.email;
      allow update: if isSignedIn() && (
        resource.data.createdBy == request.auth.token.email ||
        onlyAffects(['additionalInfo', 'title'])
      );
      allow delete: if isSignedIn()
        && resource.data.createdBy == request.auth.token.email;
    }

    match /callMapLiveLocations/{userId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && myUid() == userId;
      allow update: if isSignedIn() && myUid() == userId;
      allow delete: if isSignedIn() && myUid() == userId;
    }

    match /callMapChatRooms/{roomId} {
      allow read: if isSignedIn() && myEmail() in resource.data.members;

      allow create: if isSignedIn()
        && request.resource.data.createdBy == myEmail()
        && (myEmail() in request.resource.data.members);

      // 방장은 전체 수정 가능. 일반 멤버는 "나가기"(자기 이메일만 제거)만 가능.
      allow update: if isSignedIn() && (
        resource.data.createdBy == myEmail()
        ||
        (
          myEmail() in resource.data.members
          && onlyAffects(['members'])
          && !(myEmail() in request.resource.data.members)
        )
      );

      allow delete: if isSignedIn() && resource.data.createdBy == myEmail();

      match /messages/{messageId} {
        allow read: if isCallMapRoomMember(roomId);

        allow create: if isCallMapRoomMember(roomId)
          && request.resource.data.senderEmail == request.auth.token.email;

        // readBy arrayUnion 갱신을 위해 멤버의 update 를 허용.
        allow update: if isCallMapRoomMember(roomId);

        allow delete: if isSignedIn()
          && (resource.data.senderEmail == request.auth.token.email
              || isCallMapRoomOwner(roomId));
      }
    }

    // ---------- Default deny ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
