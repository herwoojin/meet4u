# 관리자 로그인 자격 증명 (실제 값은 .env 에 작성, .env 는 git 에 커밋되지 않음)
# - VITE_ADMIN_ID: 평문 ID
# - VITE_ADMIN_PASSWORD_HASH: 비밀번호의 SHA-256 해시
#
# 비밀번호 해시 생성:
#   printf "원하는비번" | shasum -a 256 | awk '{print $1}'
VITE_ADMIN_ID=admin
VITE_ADMIN_PASSWORD_HASH=

# (옵션) 관리자 모드에서 공유로 쓸 Gemini 무료 API 키.
# 비워두면 관리자도 본인 키를 설정에서 직접 등록해야 한다.
VITE_GEMINI_ADMIN_API_KEY=

# 카카오 로그인 — REST API 키. 비우면 src/lib/kakao.js 의 fallback 값을 사용.
# Kakao Developers > 앱 설정 > 일반 > 앱 키 > REST API 키
VITE_KAKAO_REST_API_KEY=

# 카카오 서버 함수 전용 — Netlify Site 환경변수에도 동일하게 등록해야 한다.
# (.env 는 로컬 dev 용. 운영 함수에는 Netlify 대시보드의 환경변수가 적용됨)
KAKAO_REST_API_KEY=

# 카카오 클라이언트 시크릿 — Kakao Developers > 카카오 로그인 > 보안 에서
# 클라이언트 시크릿을 활성화한 경우 반드시 필요. 비활성화 상태면 비워둠.
KAKAO_CLIENT_SECRET=
