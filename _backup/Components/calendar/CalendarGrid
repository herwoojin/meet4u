
import React from "react";
import { format, startOfMonth, endOfMonth, startOfWeek, endOfWeek, addDays, isSameMonth, isSameDay, isToday } from "date-fns";
import { ko } from "date-fns/locale";
import { Badge } from "@/components/ui/badge";
import { Users, UserCheck, UserX, Clock } from "lucide-react";

export default function CalendarGrid({ currentDate, meetings, onDateClick, onMeetingClick, currentUser }) {
  const monthStart = startOfMonth(currentDate);
  const monthEnd = endOfMonth(monthStart);
  const startDate = startOfWeek(monthStart, { locale: ko });
  const endDate = endOfWeek(monthEnd, { locale: ko });

  const days = [];
  let day = startDate;
  while (day <= endDate) {
    days.push(day);
    day = addDays(day, 1);
  }

  const getMeetingsForDate = (date) => {
    return meetings
      .filter(meeting => !meeting.is_cancelled && isSameDay(new Date(meeting.start_datetime), date))
      .sort((a, b) => new Date(a.start_datetime) - new Date(b.start_datetime));
  };

  const getAttendanceStats = (meeting) => {
    const responses = meeting.responses || {};
    const allRespondents = Object.keys(responses);
    const originalAttendees = meeting.attendees || [];
    
    // 모든 참여자 (원래 참석자 + 응답한 사람들)
    const allParticipants = [...new Set([...originalAttendees, ...allRespondents])];
    
    const attending = Object.values(responses).filter(r => r.status === "attending").length;
    const notAttending = Object.values(responses).filter(r => r.status === "not_attending").length;
    const maybe = Object.values(responses).filter(r => r.status === "maybe").length;
    const responded = allRespondents.length;
    const noResponse = Math.max(0, originalAttendees.length - responded);
    
    return { 
      total: allParticipants.length, 
      attending, 
      notAttending, 
      maybe, 
      noResponse,
      responded 
    };
  };

  const getUserResponseStatus = (meeting) => {
    if (!currentUser?.email || !meeting.responses) return "no_response";
    return meeting.responses[currentUser.email]?.status || "no_response";
  };

  const getMeetingCardStyle = (meeting) => {
    const userStatus = getUserResponseStatus(meeting);
    
    // 사용자의 응답 상태에 따른 색상
    if (userStatus === "attending") {
      return "bg-emerald-50 text-emerald-800 border-emerald-200 border rounded-md p-1.5 cursor-pointer hover:shadow-sm transition-all duration-200";
    } else if (userStatus === "not_attending") {
      return "bg-red-50 text-red-700 border-red-200 border rounded-md p-1.5 cursor-pointer hover:shadow-sm transition-all duration-200";
    } else if (userStatus === "maybe") {
      return "bg-amber-50 text-amber-800 border-amber-200 border rounded-md p-1.5 cursor-pointer hover:shadow-sm transition-all duration-200";
    } else {
      return "bg-slate-100 text-slate-700 border-slate-200 border rounded-md p-1.5 cursor-pointer hover:shadow-sm transition-all duration-200 hover:bg-blue-50 hover:border-blue-300";
    }
  };

  return (
    <div className="bg-white rounded-xl shadow-sm border border-slate-200/60 overflow-hidden">
      {/* 요일 헤더 */}
      <div className="grid grid-cols-7 border-b border-slate-100 bg-slate-50">
        {["일", "월", "화", "수", "목", "금", "토"].map((dayName, index) => (
          <div
            key={dayName}
            className={`p-3 text-center font-semibold text-sm ${
              index === 0 ? "text-red-600" : index === 6 ? "text-blue-600" : "text-slate-700"
            }`}
          >
            {dayName}
          </div>
        ))}
      </div>

      {/* 날짜 그리드 */}
      <div className="grid grid-cols-7">
        {days.map((day, index) => {
          const dayMeetings = getMeetingsForDate(day);
          const isCurrentMonth = isSameMonth(day, currentDate);
          const isTodayDate = isToday(day);
          
          return (
            <div
              key={day.toISOString()}
              onClick={() => onDateClick(day)}
              className={`min-h-32 p-2 border-r border-b border-slate-100 cursor-pointer hover:bg-slate-25 transition-colors duration-150 ${
                !isCurrentMonth ? "text-slate-300 bg-slate-50/50" : "bg-white"
              } ${index % 7 === 6 ? "border-r-0" : ""}`}
            >
              <div className="flex flex-col h-full">
                {/* 날짜 표시 */}
                <div className="flex items-center justify-between mb-2">
                  <div className={`text-sm font-medium ${
                    isTodayDate
                      ? "w-6 h-6 bg-slate-900 text-white rounded-full flex items-center justify-center text-xs"
                      : index % 7 === 0 && isCurrentMonth
                      ? "text-red-500"
                      : index % 7 === 6 && isCurrentMonth
                      ? "text-blue-500"
                      : isCurrentMonth
                      ? "text-slate-900"
                      : "text-slate-300"
                  }`}>
                    {format(day, "d")}
                  </div>
                  
                  {/* 해당 날짜의 총 미팅 수 */}
                  {dayMeetings.length > 0 && (
                    <Badge variant="outline" className="text-xs px-1 py-0.5 h-5">
                      {dayMeetings.length}
                    </Badge>
                  )}
                </div>
                
                {/* 미팅 리스트 */}
                <div className="flex-1 space-y-1 overflow-hidden">
                  {dayMeetings.slice(0, 3).map((meeting) => {
                    const stats = getAttendanceStats(meeting);
                    const startTime = format(new Date(meeting.start_datetime), "HH:mm");
                    const userStatus = getUserResponseStatus(meeting);
                    
                    return (
                      <div
                        key={meeting.id}
                        onClick={(e) => { e.stopPropagation(); onMeetingClick(meeting); }}
                        className={getMeetingCardStyle(meeting)}
                      >
                        <div className="flex items-center justify-between mb-0.5">
                          <span className="text-xs font-medium">{startTime}</span>
                          <div className="flex items-center gap-0.5">
                            <Users className="w-3 h-3" />
                            <span className="text-xs">{stats.responded}</span>
                            {userStatus === "no_response" && (
                              <div className="w-2 h-2 bg-blue-500 rounded-full ml-1" title="응답 가능"></div>
                            )}
                          </div>
                        </div>
                        <div className="text-xs font-medium truncate">{meeting.title}</div>
                        
                        {/* 실시간 참석 현황 표시 */}
                        <div className="flex items-center gap-1 mt-1">
                          {stats.attending > 0 && (
                            <div className="flex items-center gap-0.5">
                              <div className="w-2 h-2 bg-emerald-500 rounded-full"></div>
                              <span className="text-xs text-emerald-700">{stats.attending}</span>
                            </div>
                          )}
                          {stats.maybe > 0 && (
                            <div className="flex items-center gap-0.5">
                              <div className="w-2 h-2 bg-amber-500 rounded-full"></div>
                              <span className="text-xs text-amber-700">{stats.maybe}</span>
                            </div>
                          )}
                          {stats.notAttending > 0 && (
                            <div className="flex items-center gap-0.5">
                              <div className="w-2 h-2 bg-red-500 rounded-full"></div>
                              <span className="text-xs text-red-700">{stats.notAttending}</span>
                            </div>
                          )}
                          {stats.noResponse > 0 && (
                            <div className="flex items-center gap-0.5">
                              <div className="w-2 h-2 bg-slate-400 rounded-full"></div>
                              <span className="text-xs text-slate-500">{stats.noResponse}</span>
                            </div>
                          )}
                        </div>
                        
                        {/* 응답하지 않은 미팅 표시 */}
                        {userStatus === "no_response" && (
                          <div className="text-xs text-blue-600 mt-1 font-medium">
                            클릭하여 응답하세요
                          </div>
                        )}
                      </div>
                    );
                  })}
                  
                  {/* 더 많은 미팅이 있을 때 */}
                  {dayMeetings.length > 3 && (
                    <div className="text-xs text-slate-500 text-center py-1 bg-slate-50 rounded cursor-pointer hover:bg-slate-100">
                      +{dayMeetings.length - 3}개 더 보기
                    </div>
                  )}
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  );
}
