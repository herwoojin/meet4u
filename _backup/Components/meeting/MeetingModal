import React, { useState } from "react";
import { format } from "date-fns";
import { ko } from "date-fns/locale";
import { Dialog, DialogContent, DialogHeader, DialogTitle, DialogFooter } from "@/components/ui/dialog";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { Avatar, AvatarFallback, AvatarImage } from "@/components/ui/avatar";
import { Clock, MapPin, Users, Edit, Trash2, Video, Check, X, Clock3, Loader2, AlertTriangle, Search } from "lucide-react";
import { Meeting } from "@/entities/Meeting";
import { Alert, AlertDescription } from "@/components/ui/alert";

export default function MeetingModal({ meeting, isOpen, onClose, onEdit, onDelete, onDataChange, currentUser, userMap }) {
  const [isUpdating, setIsUpdating] = useState(false);
  const [isCancelling, setIsCancelling] = useState(false);

  if (!meeting) return null;

  const isCreator = currentUser && meeting.created_by === currentUser.email;
  const userResponse = meeting.responses?.[currentUser?.email]?.status;

  const handleResponseUpdate = async (status) => {
    if (!currentUser) return;
    
    setIsUpdating(true);
    try {
      const updatedResponses = { 
        ...(meeting.responses || {}), 
        [currentUser.email]: { status, responded_at: new Date().toISOString() } 
      };
      
      // 응답하는 사용자를 참석자 목록에 추가 (이미 있으면 중복 제거)
      const updatedAttendees = [...new Set([...(meeting.attendees || []), currentUser.email])];
      
      await Meeting.update(meeting.id, { 
        responses: updatedResponses, 
        attendees: updatedAttendees 
      });
      
      if (onDataChange) {
        await onDataChange();
      }
    } catch (error) {
      console.error("Error updating response:", error);
      alert("응답 업데이트 중 오류가 발생했습니다.");
    } finally {
      setIsUpdating(false);
    }
  };

  const handleCancelMeeting = async () => {
    if (!isCreator || !window.confirm("정말로 이 미팅을 취소하시겠습니까?")) return;
    
    setIsCancelling(true);
    try {
      await Meeting.update(meeting.id, { is_cancelled: true });
      if (onDataChange) {
        await onDataChange();
      }
      onClose();
    } catch (error) {
      console.error("Error cancelling meeting:", error);
      alert("미팅 취소 중 오류가 발생했습니다.");
    } finally {
      setIsCancelling(false);
    }
  };

  const openNaverMap = () => {
    if (meeting.location) {
      const query = encodeURIComponent(meeting.location);
      window.open(`https://map.naver.com/p/search/${query}`, '_blank');
    } else {
      window.open(`https://map.naver.com`, '_blank');
    }
  };

  const getStatusInfo = (status) => {
    switch (status) {
      case "attending": 
        return { text: "참석", color: "bg-emerald-100 text-emerald-800", icon: <Check className="w-3 h-3" /> };
      case "not_attending": 
        return { text: "불참", color: "bg-red-100 text-red-800", icon: <X className="w-3 h-3" /> };
      case "maybe": 
        return { text: "미정", color: "bg-amber-100 text-amber-800", icon: <Clock3 className="w-3 h-3" /> };
      default: 
        return { text: "미응답", color: "bg-slate-100 text-slate-600", icon: null };
    }
  };
  
  const getAllParticipants = () => {
    const responses = meeting.responses || {};
    const originalAttendees = meeting.attendees || [];
    const allRespondents = Object.keys(responses);
    const allParticipantEmails = [...new Set([...originalAttendees, ...allRespondents])];
    
    return allParticipantEmails.map(email => {
      const user = userMap.get(email);
      return {
        email,
        displayName: user?.nickname || user?.full_name || email,
        avatarUrl: user?.avatar_url,
        response: responses[email],
        isOriginalAttendee: originalAttendees.includes(email),
        isCurrentUser: email === currentUser?.email
      };
    });
  };

  const allParticipants = getAllParticipants();
  const stats = {
    attending: allParticipants.filter(p => p.response?.status === "attending").length,
    maybe: allParticipants.filter(p => p.response?.status === "maybe").length,
    notAttending: allParticipants.filter(p => p.response?.status === "not_attending").length,
    noResponse: allParticipants.filter(p => !p.response).length,
    responded: allParticipants.length - allParticipants.filter(p => !p.response).length
  };

  return (
    <Dialog open={isOpen} onOpenChange={onClose}>
      <DialogContent className="max-w-2xl max-h-[90vh] overflow-y-auto">
        <DialogHeader>
          <DialogTitle className="text-xl font-bold text-slate-900 flex items-center gap-2">
            {meeting.title}
            {meeting.is_cancelled && <Badge variant="destructive">취소됨</Badge>}
          </DialogTitle>
        </DialogHeader>
        
        <div className="space-y-6 py-4">
          {meeting.is_cancelled && (
            <Alert variant="destructive">
              <AlertTriangle className="h-4 w-4" />
              <AlertDescription>이 미팅은 취소되었습니다.</AlertDescription>
            </Alert>
          )}

          <div className="space-y-4">
            <div className="flex items-start gap-3">
              <Clock className="w-5 h-5 text-slate-500 mt-0.5" />
              <div>
                <div className="font-medium text-slate-900">
                  {format(new Date(meeting.start_datetime), "yyyy년 M월 d일 (EEEE)", { locale: ko })}
                </div>
                <div className="text-slate-600">
                  {format(new Date(meeting.start_datetime), "HH:mm")} - {format(new Date(meeting.end_datetime), "HH:mm")}
                </div>
              </div>
            </div>

            {meeting.location && (
              <div className="flex items-start gap-3">
                <div className="flex items-center gap-3">
                  {meeting.meeting_type === "online" ? (
                    <Video className="w-5 h-5 text-slate-500" />
                  ) : (
                    <MapPin className="w-5 h-5 text-slate-500" />
                  )}
                  <span className="text-slate-700">{meeting.location}</span>
                </div>
                <Button 
                  type="button" 
                  onClick={openNaverMap} 
                  className="ml-auto bg-green-100 text-green-800 hover:bg-green-200 rounded-full text-sm font-semibold px-4 py-2 h-8"
                  size="sm"
                >
                  <Search className="w-4 h-4 mr-2"/>
                  네이버지도
                </Button>
              </div>
            )}
          </div>

          <div className="bg-slate-50 rounded-lg p-4">
            <h4 className="font-semibold text-slate-900 mb-3 flex items-center gap-2">
              <Users className="w-5 h-5" />
              실시간 참석 현황
            </h4>
            <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
              <div className="text-center">
                <div className="text-2xl font-bold text-emerald-600">{stats.attending}</div>
                <div className="text-xs text-slate-600">참석</div>
              </div>
              <div className="text-center">
                <div className="text-2xl font-bold text-amber-600">{stats.maybe}</div>
                <div className="text-xs text-slate-600">미정</div>
              </div>
              <div className="text-center">
                <div className="text-2xl font-bold text-red-600">{stats.notAttending}</div>
                <div className="text-xs text-slate-600">불참</div>
              </div>
              <div className="text-center">
                <div className="text-2xl font-bold text-slate-400">{stats.noResponse}</div>
                <div className="text-xs text-slate-600">미응답</div>
              </div>
            </div>
            <div className="text-center mt-2 pt-2 border-t border-slate-200">
              <div className="text-sm text-slate-600">
                총 <span className="font-semibold">{stats.responded}</span>명이 응답했습니다
              </div>
            </div>
          </div>

          {meeting.description && (
            <div className="bg-slate-50 rounded-lg p-4">
              <h4 className="font-medium text-slate-900 mb-2">설명</h4>
              <p className="text-slate-700 whitespace-pre-wrap">{meeting.description}</p>
            </div>
          )}

          {allParticipants.length > 0 && (
            <div>
              <h4 className="font-medium text-slate-900 mb-3">참석자 목록</h4>
              <div className="space-y-2 max-h-48 overflow-y-auto">
                {allParticipants.map(p => {
                  const statusInfo = getStatusInfo(p.response?.status);
                  return (
                    <div 
                      key={p.email} 
                      className={`flex items-center justify-between p-2 rounded-lg ${
                        p.isCurrentUser ? "bg-blue-50 border border-blue-200" : "bg-white border"
                      }`}
                    >
                      <div className="flex items-center gap-3">
                        <Avatar className="h-8 w-8">
                          <AvatarImage src={p.avatarUrl} />
                          <AvatarFallback className="text-xs bg-slate-100">
                            {p.displayName.charAt(0).toUpperCase()}
                          </AvatarFallback>
                        </Avatar>
                        <div>
                          <div className="flex items-center gap-2">
                            <span className="text-sm font-medium text-slate-700">{p.displayName}</span>
                            {!p.isOriginalAttendee && (
                              <span className="text-xs text-slate-500">(추가 참석)</span>
                            )}
                          </div>
                          {p.response?.responded_at && (
                            <div className="text-xs text-slate-500">
                              {format(new Date(p.response.responded_at), "MM/dd HH:mm")} 응답
                            </div>
                          )}
                        </div>
                      </div>
                      <Badge className={`text-xs ${statusInfo.color} flex items-center gap-1`}>
                        {statusInfo.icon}
                        {statusInfo.text}
                      </Badge>
                    </div>
                  );
                })}
              </div>
            </div>
          )}
          
          {!meeting.is_cancelled && currentUser && (
            <div className="bg-blue-50 rounded-lg p-4 border border-blue-200">
              <h4 className="font-medium text-slate-900 mb-3">
                {userResponse ? "참석 여부 변경" : "참석 여부 응답"}
              </h4>
              <div className="flex gap-2 flex-wrap">
                {isUpdating ? (
                  <Button disabled className="w-full">
                    <Loader2 className="w-4 h-4 mr-2 animate-spin" />
                    응답 업데이트 중...
                  </Button>
                ) : (
                  <>
                    <Button 
                      variant={userResponse === "attending" ? "default" : "outline"} 
                      size="sm" 
                      onClick={() => handleResponseUpdate("attending")}
                      className={`flex-1 ${userResponse === "attending" ? "bg-emerald-600 hover:bg-emerald-700" : ""}`}
                    >
                      <Check className="w-4 h-4 mr-1" />
                      참석
                    </Button>
                    <Button 
                      variant={userResponse === "maybe" ? "default" : "outline"} 
                      size="sm" 
                      onClick={() => handleResponseUpdate("maybe")}
                      className={`flex-1 ${userResponse === "maybe" ? "bg-amber-600 hover:bg-amber-700" : ""}`}
                    >
                      <Clock3 className="w-4 h-4 mr-1" />
                      미정
                    </Button>
                    <Button 
                      variant={userResponse === "not_attending" ? "default" : "outline"} 
                      size="sm" 
                      onClick={() => handleResponseUpdate("not_attending")}
                      className={`flex-1 ${userResponse === "not_attending" ? "bg-red-600 hover:bg-red-700" : ""}`}
                    >
                      <X className="w-4 h-4 mr-1" />
                      불참
                    </Button>
                  </>
                )}
              </div>
            </div>
          )}
        </div>

        <DialogFooter>
          <div className="flex justify-between w-full">
            {isCreator && !meeting.is_cancelled ? (
              <div className="flex gap-2 flex-wrap">
                <Button variant="outline" onClick={onEdit} size="sm">
                  <Edit className="w-4 h-4 mr-2" />
                  수정
                </Button>
                <Button 
                  variant="outline" 
                  onClick={handleCancelMeeting} 
                  disabled={isCancelling}
                  className="text-amber-600 hover:text-amber-700" 
                  size="sm"
                >
                  {isCancelling ? (
                    <Loader2 className="w-4 h-4 mr-2 animate-spin" />
                  ) : (
                    <AlertTriangle className="w-4 h-4 mr-2" />
                  )}
                  취소
                </Button>
                <Button variant="destructive" onClick={onDelete} size="sm">
                  <Trash2 className="w-4 h-4 mr-2" />
                  삭제
                </Button>
              </div>
            ) : (
              <div />
            )}
            <Button onClick={onClose}>닫기</Button>
          </div>
        </DialogFooter>
      </DialogContent>
    </Dialog>
  );
}