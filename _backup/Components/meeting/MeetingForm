import React from "react";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Textarea } from "@/components/ui/textarea";
import { Label } from "@/components/ui/label";
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "@/components/ui/select";
import { Badge } from "@/components/ui/badge";
import { X, Plus, Users, Clock, MapPin, Loader2 } from "lucide-react";
import { format } from "date-fns";

export default function MeetingForm({ meeting, onSubmit, onCancel, isSubmitting }) {
  const [formData, setFormData] = React.useState({
    title: "", description: "", start_datetime: "", end_datetime: "", location: "", meeting_type: "online", attendees: []
  });
  const [newAttendeeEmail, setNewAttendeeEmail] = React.useState("");

  React.useEffect(() => {
    if (meeting) {
      setFormData({
        title: meeting.title || "",
        description: meeting.description || "",
        start_datetime: meeting.start_datetime ? format(new Date(meeting.start_datetime), "yyyy-MM-dd'T'HH:mm") : "",
        end_datetime: meeting.end_datetime ? format(new Date(meeting.end_datetime), "yyyy-MM-dd'T'HH:mm") : "",
        location: meeting.location || "",
        meeting_type: meeting.meeting_type || "online",
        attendees: meeting.attendees || []
      });
    }
  }, [meeting]);

  const handleInputChange = (field, value) => setFormData(p => ({ ...p, [field]: value }));

  const addAttendee = () => {
    const email = newAttendeeEmail.trim();
    if (email && !formData.attendees.includes(email)) {
      setFormData(p => ({ ...p, attendees: [...p.attendees, email] }));
      setNewAttendeeEmail("");
    }
  };

  const removeAttendee = (email) => setFormData(p => ({ ...p, attendees: p.attendees.filter(e => e !== email) }));

  const handleSubmit = (e) => {
    e.preventDefault();
    if (!formData.title || !formData.start_datetime || !formData.end_datetime) {
      alert("제목과 시작/종료 시간은 필수입니다."); return;
    }
    onSubmit({ ...formData, start_datetime: new Date(formData.start_datetime).toISOString(), end_datetime: new Date(formData.end_datetime).toISOString() });
  };

  return (
    <div className="bg-white rounded-xl shadow-sm border border-slate-200/60">
      <form onSubmit={handleSubmit} className="p-6 space-y-6">
        <div>
          <Label htmlFor="title" className="font-medium">미팅 제목 *</Label>
          <Input id="title" value={formData.title} onChange={e => handleInputChange("title", e.target.value)} required className="mt-1" />
        </div>
        
        <div className="grid md:grid-cols-2 gap-4">
          <div>
            <Label htmlFor="start_datetime" className="font-medium flex items-center gap-1.5">
              <Clock className="w-4 h-4" />시작 시간 *
            </Label>
            <Input id="start_datetime" type="datetime-local" value={formData.start_datetime} onChange={e => handleInputChange("start_datetime", e.target.value)} required className="mt-1" />
          </div>
          <div>
            <Label htmlFor="end_datetime" className="font-medium">종료 시간 *</Label>
            <Input id="end_datetime" type="datetime-local" value={formData.end_datetime} onChange={e => handleInputChange("end_datetime", e.target.value)} required className="mt-1" />
          </div>
        </div>
        
        <div className="grid md:grid-cols-2 gap-4">
          <div>
            <Label className="font-medium">미팅 형태</Label>
            <Select value={formData.meeting_type} onValueChange={v => handleInputChange("meeting_type", v)}>
              <SelectTrigger className="mt-1">
                <SelectValue />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="online">온라인</SelectItem>
                <SelectItem value="offline">오프라인</SelectItem>
                <SelectItem value="hybrid">하이브리드</SelectItem>
              </SelectContent>
            </Select>
          </div>
          <div>
            <Label htmlFor="location" className="font-medium flex items-center gap-1.5">
              <MapPin className="w-4 h-4" />장소
            </Label>
            <Input id="location" value={formData.location} onChange={e => handleInputChange("location", e.target.value)} placeholder={formData.meeting_type === 'online' ? 'Zoom/Meet 링크' : '회의실, 주소'} className="mt-1" />
          </div>
        </div>
        
        <div>
          <Label className="font-medium flex items-center gap-1.5 mb-2">
            <Users className="w-4 h-4" />참석자
          </Label>
          <div className="flex gap-2">
            <Input value={newAttendeeEmail} onChange={e => setNewAttendeeEmail(e.target.value)} placeholder="참석자 이메일 입력 후 Enter" onKeyPress={e => e.key === "Enter" && (e.preventDefault(), addAttendee())} />
            <Button type="button" onClick={addAttendee} variant="outline">
              <Plus className="w-4 h-4" />
            </Button>
          </div>
          {formData.attendees.length > 0 && (
            <div className="flex flex-wrap gap-2 mt-3">
              {formData.attendees.map(email => 
                <Badge key={email} variant="secondary" className="pl-2 pr-1 py-0.5">
                  {email}
                  <button type="button" onClick={() => removeAttendee(email)} className="ml-1.5 p-0.5 rounded-full hover:bg-slate-300">
                    <X className="w-3 h-3" />
                  </button>
                </Badge>
              )}
            </div>
          )}
        </div>
        
        <div>
          <Label htmlFor="description" className="font-medium">설명</Label>
          <Textarea id="description" value={formData.description} onChange={e => handleInputChange("description", e.target.value)} rows={4} className="mt-1" />
        </div>
        
        <div className="flex justify-end gap-3 pt-4 border-t border-slate-100">
          <Button type="button" variant="outline" onClick={onCancel} disabled={isSubmitting}>취소</Button>
          <Button type="submit" disabled={isSubmitting} className="bg-slate-900 hover:bg-slate-800 text-white w-24">
            {isSubmitting ? <Loader2 className="w-4 h-4 animate-spin" /> : (meeting?.id ? "수정" : "생성")}
          </Button>
        </div>
      </form>
    </div>
  );
}